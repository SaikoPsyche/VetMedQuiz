            <ui:Button text="Student&#10;" name="Level1" style="visibility: visible; top: 292px; background-image: url(&quot;project://database/Assets/Saurabh%20Studio/Awesome%20Game%20UI%20pack%208/Bubble%20Style%20Pack/Bubble%20Button%204/Rectangle%20Button.png?fileID=2800000&amp;guid=9eff1f219b7a4c6409ec2622841e9c5f&amp;type=3#Rectangle Button&quot;); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 400px; height: 90px; -unity-text-align: lower-center; font-size: 24px;"/>
            <ui:Button text="Vet Tech" name="Level2" style="visibility: visible; top: 313px; background-image: url(&quot;project://database/Assets/Saurabh%20Studio/Awesome%20Game%20UI%20pack%208/Bubble%20Style%20Pack/Bubble%20Button%204/Rectangle%20Button.png?fileID=2800000&amp;guid=9eff1f219b7a4c6409ec2622841e9c5f&amp;type=3#Rectangle Button&quot;); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); width: 391px; height: 100px; font-size: 24px;"/>
