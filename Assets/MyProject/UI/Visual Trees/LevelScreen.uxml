<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Container" style="flex-grow: 1; align-items: center;">
        <ui:Image name="BG" scale-mode="StretchToFill" style="height: 863px; background-image: url(&quot;project://database/Assets/Saurabh%20Studio/Awesome%20Game%20UI%20pack%209/Dialogue%20Back%203/5.png?fileID=2800000&amp;guid=ae66985019f18644d91dd4ee6fcc8ff5&amp;type=3#5&quot;); width: 536px; visibility: visible; align-items: center; top: 15px;">
            <ui:Image name="TitleBG" style="top: 192px; visibility: visible; background-image: url(&quot;project://database/Assets/Saurabh%20Studio/Awesome%20Game%20UI%20pack%208/Bubble%20Style%20Pack/Bubble%20Button%204/Dailogue-Back.png?fileID=2800000&amp;guid=4e299201e2953dd40b0b5c0066f02c84&amp;type=3#Dailogue-Back&quot;); height: 176px; width: 426px;">
                <ui:Label text="Enter Your Name &#10;And&#10;Choose Your Level" name="TitleText" style="-unity-text-align: middle-center; height: 165px; font-size: 36px; top: 6px;"/>
            </ui:Image>
            <ui:Image style="position: absolute; height: 83px; width: 131px; top: 391px; left: 66px; background-image: url(&quot;project://database/Assets/Saurabh%20Studio/Awesome%20Game%20UI%20pack%208/Bubble%20Style%20Pack/Bubble%20Button%204/Dailogue-Back.png?fileID=2800000&amp;guid=4e299201e2953dd40b0b5c0066f02c84&amp;type=3#Dailogue-Back&quot;);"/>
            <ui:TextField label="Name:" placeholder-text="Your Name Here" name="Name" style="top: 234px; visibility: visible; overflow: visible; height: 42px; width: 427px; -unity-text-align: middle-center; font-size: 24px;">
                <Bindings>
                    <ui:DataBinding property="placeholderText" data-source-path="PlayerName" data-source="project://database/Assets/Resources/Player.asset?fileID=11400000&amp;guid=4eee0c7fb129b9d408121f63ee44b142&amp;type=2#Player" binding-mode="TwoWay"/>
                </Bindings>
